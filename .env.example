# Local development; copy to .env.local without overwriting existing values.
# Matches docker-compose.yml. These credentials are for local development only.
DATABASE_URL=postgresql://fitpassfinder:fitpassfinder_dev@localhost:5432/fitpassfinder
DATABASE_MIGRATION_URL=postgresql://fitpassfinder:fitpassfinder_dev@localhost:5432/fitpassfinder

# Cloud runtime: replace DATABASE_URL with Supabase Connect -> Transaction pooler.
# Cloud migrations: use a direct connection or Session pooler in a separate file/job.
# Keep database URLs server-side; never prefix them with NEXT_PUBLIC_.

# Public MapLibre style URL. Proposal: a MapTiler style URL with a domain-limited key.
# Set locally and separately for Vercel Preview / Production once a provider is chosen.
NEXT_PUBLIC_MAP_STYLE_URL=

# Optional, only when Supabase Auth is implemented (not required for Drizzle queries).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
