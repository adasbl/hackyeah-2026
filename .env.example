# Copy to .env.local without overwriting existing values.
# Both local Next.js and Vercel use PostgreSQL/PostGIS hosted in Supabase.
# Copy the complete connection strings from Supabase -> Connect and supply the password.
# URL-encode special characters in the password; never commit real credentials.

# App runtime: Transaction pooler for the selected Supabase project.
DATABASE_URL=
# Migrations, seed and importers: direct connection or Session pooler for the same project.
DATABASE_MIGRATION_URL=
# Keep database URLs server-side; never prefix them with NEXT_PUBLIC_.

# Public MapLibre style URL. Proposal: a MapTiler style URL with a domain-limited key.
# Set locally and separately for Vercel Preview / Production once a provider is chosen.
NEXT_PUBLIC_MAP_STYLE_URL=

# Required for administrator login (public browsing and submissions use DATABASE_URL).
# Use the same Supabase project as the database; copy from Supabase -> Connect.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
